APP_NAME="Lead Generation Quiz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set MAIL_MAILER=mailgun when Mailgun credentials are configured.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Generated per environment with: php artisan curator:token
# Required for Filament Curator / Glide media uploads. Also run: php artisan storage:link
CURATOR_GLIDE_TOKEN=
CURATOR_DEFAULT_DISK=public

# Laravel AI SDK providers (secrets only). Choose provider+model in Operational settings.
# Optional URL overrides: OPENAI_URL, ANTHROPIC_URL, GEMINI_URL, OPENAI_COMPATIBLE_URL, …
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_URL=

# Reasoning models spend hidden tokens before answering, which can push a
# schema-constrained generation past its request timeout. Providers that support
# the toggle are asked to disable it. Set false to allow extended reasoning.
AI_DISABLE_REASONING=true
AI_MAX_OUTPUT_TOKENS=16000

# Diagnostics for slow or failing AI calls. Writes provider, model, duration,
# tokens, and finish reason to storage/logs/ai-*.log. Content logging also
# records prompts and respondent answers: enable it only while debugging.
AI_DEBUG_LOG=false
AI_DEBUG_LOG_CONTENT=false

# Server-to-server admin API Bearer token (quiz generation + user provisioning).
# Set a 64-character random value in production; never expose it in clients.
QUIZ_GENERATION_API_TOKEN=

# Cloudflare Turnstile is required before accepting public submissions in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
